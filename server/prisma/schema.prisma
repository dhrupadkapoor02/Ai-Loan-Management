// Prisma schema for the AI-Powered Finance & Loan Management System
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Models are added incrementally, module by module, so each migration stays
// small and reviewable:
//   Module 2  -> User, RefreshToken
//   Module 3  -> Category, Income, Expense, Budget, SavingsGoal
//   Module 4  -> Loan, LoanApplication                             <-- current
//   Module 5  -> CreditScore
//   Module 6  -> FinancialReport
//   Module 8  -> Notification
// ---------------------------------------------------------------------------

enum CategoryType {
  INCOME
  EXPENSE
}

/// A category is either a system default (userId is null, visible to every
/// user, seeded once via prisma/seed.js) or a user-created custom category.
/// Both share one table so income/expense records only ever need a single
/// categoryId FK regardless of which kind it points to.
model Category {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      CategoryType
  icon      String?
  isDefault Boolean @default(false)

  incomes  Income[]
  expenses Expense[]
  budgets  Budget[]

  createdAt DateTime @default(now())

  // A user can't have two categories with the same name+type (and default
  // categories, userId = null, follow the same uniqueness rule among
  // themselves).
  @@unique([userId, name, type])
  @@index([userId])
  @@map("categories")
}

model Income {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  amount      Decimal  @db.Decimal(12, 2)
  source      String?
  description String?
  date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("incomes")
}

model Expense {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  amount        Decimal  @db.Decimal(12, 2)
  paymentMethod String?
  description   String?
  date          DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@map("expenses")
}

/// One budget row per (user, category, month, year).
model Budget {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)
  month  Int // 1-12
  year   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@map("budgets")
}

model SavingsGoal {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  targetAmount  Decimal   @db.Decimal(12, 2)
  currentAmount Decimal   @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  isCompleted   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("savings_goals")
}

enum Role {
  USER
  ADMIN
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String // bcrypt hash, never the plaintext

  role Role @default(USER)

  // Email verification
  isEmailVerified         Boolean   @default(false)
  emailVerificationToken  String? // sha256 hash of the token emailed to the user
  emailVerificationExpiry DateTime?

  // Password reset
  passwordResetToken  String? // sha256 hash of the token emailed to the user
  passwordResetExpiry DateTime?

  // Account status — lets admins disable a user without deleting them
  isActive Boolean @default(true)

  refreshTokens RefreshToken[]

  categories       Category[]
  incomes          Income[]
  expenses         Expense[]
  budgets          Budget[]
  savingsGoals     SavingsGoal[]
  loans            Loan[]
  loanApplications LoanApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

/// One row per issued refresh token, so any individual session/device can be
/// revoked (logout, "log out of all devices", or automatic rotation on
/// reuse-detection) without invalidating the user's password or other
/// sessions.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // We never store the raw refresh token — only its sha256 hash — so a DB
  // leak alone can't be used to impersonate a user.
  tokenHash String @unique

  expiresAt DateTime
  revoked   Boolean  @default(false)

  // Set when this token is rotated into a new one, so we can detect and
  // react to refresh-token reuse (a strong signal of token theft).
  replacedByTokenHash String?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum LoanType {
  PERSONAL
  HOME
  AUTO
  EDUCATION
  BUSINESS
  OTHER
}

enum LoanApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

/// Represents a loan the user currently holds (or is tracking), saved from
/// the EMI calculator. `isActive` loans count as existing debt obligations
/// when checking eligibility for a *new* loan application.
model Loan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String? // user-given nickname, e.g. "Home Loan - SBI"
  lender String?
  type   LoanType

  principal     Decimal @db.Decimal(14, 2)
  interestRate  Decimal @db.Decimal(5, 2) // annual %, e.g. 8.50
  tenureMonths  Int
  emiAmount     Decimal @db.Decimal(12, 2) // computed at save time, cached for quick reads
  totalInterest Decimal @db.Decimal(14, 2)
  totalPayment  Decimal @db.Decimal(14, 2)

  isActive Boolean @default(true)
  notes    String?

  applications LoanApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
  @@map("loans")
}

/// A formal application for a *new* loan, distinct from Loan (which tracks
/// loans the user already has). Approve/reject is an admin action, added in
/// the Admin module — user-facing actions here are submit + cancel.
model LoanApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  loanId String?
  loan   Loan?   @relation(fields: [loanId], references: [id], onDelete: SetNull)

  type            LoanType
  amountRequested Decimal  @db.Decimal(14, 2)
  interestRate    Decimal  @db.Decimal(5, 2)
  tenureMonths    Int
  purpose         String?

  status LoanApplicationStatus @default(PENDING)

  reviewedBy   String? // admin User.id
  reviewNotes  String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("loan_applications")
}
